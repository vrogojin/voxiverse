COSMOS GEN-CONVOY §6 — allocator-lock stall probe (core), compile-gated + runtime-gated, byte-off.

Adds a per-thread allocation wall-time probe to core/os/memory.cpp (alloc_static/free_static/realloc_static)
that splits the "~430 ms unmetered" worst frame (docs/COSMOS-GEN-CONVOY-DESIGN.md §1) into main-thread vs
worker allocation stall time. Compile-gated by a new web scons option `alloc_probe` (default False =>
byte-identical: the ZN_PROBE_* macros expand to raw libc malloc/free/realloc). Runtime-gated by
zn_vox_alloc_probe_set_enabled (flipped from FP_GEN_ALLOC_PROBE via cosmos setup) so both A/B arms can carry
the probe; totals are read by the godot_voxel module via the weak extern "C" zn_vox_alloc_probe_read.
Applies on top of godot engine patches 0001 + 0002.
diff --git a/core/os/memory.cpp b/core/os/memory.cpp
--- a/core/os/memory.cpp
+++ b/core/os/memory.cpp
@@ -35,6 +35,92 @@
 #include <stdlib.h>
 #include <string.h>
 
+// VOXIVERSE COSMOS GEN-CONVOY (docs/COSMOS-GEN-CONVOY-DESIGN.md §6) — allocator-lock stall probe.
+// Compile-gated by the web scons option `alloc_probe` (-DZN_VOX_ALLOC_PROBE); ABSENT by default, so the
+// three macros below expand to the raw libc calls => byte-identical to stock Godot. When present, every
+// malloc/free/realloc is wall-timed (only while zn_alloc_probe_enabled, flipped by FP_GEN_ALLOC_PROBE via
+// the weak zn_vox_alloc_probe_set_enabled) and its duration accumulated into main-thread vs worker buckets
+// (classified by Thread::is_main_thread(), a thread_local int compare). remote_bridge reads the totals via
+// the weak zn_vox_alloc_probe_read and differences them over its window, turning the "~430 ms unmetered"
+// spike into a measured main-thread lock-stall number — the ONE thing a GDScript timer cannot see.
+#ifdef ZN_VOX_ALLOC_PROBE
+#include "core/os/os.h"
+#include "core/os/thread.h"
+#include <atomic>
+namespace {
+struct ZnAllocProbe {
+	SafeNumeric<uint64_t> main_usec;
+	SafeNumeric<uint64_t> main_count;
+	SafeNumeric<uint64_t> work_usec;
+	SafeNumeric<uint64_t> work_count;
+};
+ZnAllocProbe zn_alloc_probe;
+std::atomic<bool> zn_alloc_probe_enabled{ false };
+// Disabled => one relaxed atomic load per alloc and nothing else. Enabled => two get_ticks_usec reads.
+// OS may be null during earliest static-init allocs; those are skipped. No allocation happens inside the
+// probe (SafeNumeric is lock-free; is_main_thread() is a thread_local compare) so it cannot recurse.
+_ALWAYS_INLINE_ uint64_t zn_probe_t0() {
+	if (!zn_alloc_probe_enabled.load(std::memory_order_relaxed)) {
+		return 0;
+	}
+	const OS *os = OS::get_singleton();
+	return os != nullptr ? os->get_ticks_usec() : 0;
+}
+_ALWAYS_INLINE_ void zn_probe_acc(uint64_t p_t0) {
+	if (p_t0 == 0) {
+		return;
+	}
+	const OS *os = OS::get_singleton();
+	if (os == nullptr) {
+		return;
+	}
+	const uint64_t dt = os->get_ticks_usec() - p_t0;
+	if (Thread::is_main_thread()) {
+		zn_alloc_probe.main_usec.add(dt);
+		zn_alloc_probe.main_count.increment();
+	} else {
+		zn_alloc_probe.work_usec.add(dt);
+		zn_alloc_probe.work_count.increment();
+	}
+}
+_ALWAYS_INLINE_ void *zn_probe_malloc(size_t p_size) {
+	const uint64_t t0 = zn_probe_t0();
+	void *p = malloc(p_size);
+	zn_probe_acc(t0);
+	return p;
+}
+_ALWAYS_INLINE_ void *zn_probe_realloc(void *p_mem, size_t p_size) {
+	const uint64_t t0 = zn_probe_t0();
+	void *p = realloc(p_mem, p_size);
+	zn_probe_acc(t0);
+	return p;
+}
+_ALWAYS_INLINE_ void zn_probe_free(void *p_mem) {
+	const uint64_t t0 = zn_probe_t0();
+	free(p_mem);
+	zn_probe_acc(t0);
+}
+} // namespace
+// Non-mangled so the godot_voxel module can weak-link these and no-op when the probe is not compiled in.
+extern "C" bool zn_vox_alloc_probe_read(double *r_main_ms, double *r_work_ms, uint64_t *r_main_n, uint64_t *r_work_n) {
+	*r_main_ms = double(zn_alloc_probe.main_usec.get()) / 1000.0;
+	*r_work_ms = double(zn_alloc_probe.work_usec.get()) / 1000.0;
+	*r_main_n = zn_alloc_probe.main_count.get();
+	*r_work_n = zn_alloc_probe.work_count.get();
+	return true;
+}
+extern "C" void zn_vox_alloc_probe_set_enabled(bool p_enabled) {
+	zn_alloc_probe_enabled.store(p_enabled, std::memory_order_relaxed);
+}
+#define ZN_PROBE_MALLOC(m_size) zn_probe_malloc(m_size)
+#define ZN_PROBE_REALLOC(m_mem, m_size) zn_probe_realloc((m_mem), (m_size))
+#define ZN_PROBE_FREE(m_mem) zn_probe_free(m_mem)
+#else
+#define ZN_PROBE_MALLOC(m_size) malloc(m_size)
+#define ZN_PROBE_REALLOC(m_mem, m_size) realloc((m_mem), (m_size))
+#define ZN_PROBE_FREE(m_mem) free(m_mem)
+#endif
+
 void *operator new(size_t p_size, const char *p_description) {
 	return Memory::alloc_static(p_size, false);
 }
