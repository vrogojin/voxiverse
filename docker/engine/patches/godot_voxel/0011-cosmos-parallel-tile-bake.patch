+// FP_CPP_TILE_BAKE (F1): the per-call open-addressed table bake_far_tile's edit branch hashes into.
+// Built ONCE per call from `edit_cells`/`edit_far_idx` (both frozen main-thread snapshots at dispatch --
+// see facet_tex_baker.gd's `_edit_snap`), so the per-texel loop performs zero heap allocation. Presence
+// in the table (not the VALUE) signals "this column was edited" -- edit_far_idx[i] may legitimately be
+// 0 (a dug-to-air edit still resolves to SOME palette index via FarPalette.far_color_index_of_block), so
+// a `used` flag is kept alongside the key/value slots rather than relying on a sentinel value.
+struct EditTable {
+	std::vector<int64_t> keys;
+	std::vector<int32_t> vals;
+	std::vector<uint8_t> used;
+	uint32_t mask = 0;
+
+	void build(const PackedInt64Array &cells, const PackedInt32Array &far_idx) {
+		const int n = cells.size();
+		uint32_t cap = 16;
+		while (cap < uint32_t(n) * 2 + 1) {
+			cap <<= 1;
+		}
+		keys.assign(cap, 0);
+		vals.assign(cap, 0);
+		used.assign(cap, 0);
+		mask = cap - 1;
+		for (int i = 0; i < n; ++i) {
+			const int64_t key = cells[i];
+			uint64_t h = uint64_t(key) * 0x9E3779B97F4A7C15ULL;
+			uint32_t slot = uint32_t(h >> 32) & mask;
+			while (used[slot]) {
+				slot = (slot + 1) & mask;
+			}
+			used[slot] = 1;
+			keys[slot] = key;
+			vals[slot] = (i < far_idx.size()) ? far_idx[i] : 0;
+		}
+	}
+
+	bool find(int64_t key, int32_t *out_val) const {
+		if (mask == 0) {
+			return false;
+		}
+		uint64_t h = uint64_t(key) * 0x9E3779B97F4A7C15ULL;
+		uint32_t slot = uint32_t(h >> 32) & mask;
+		for (;;) {
+			if (!used[slot]) {
+				return false;
+			}
+			if (keys[slot] == key) {
+				*out_val = vals[slot];
+				return true;
+			}
+			slot = (slot + 1) & mask;
+		}
+	}
+};
