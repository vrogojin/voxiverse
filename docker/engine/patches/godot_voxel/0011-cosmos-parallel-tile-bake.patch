+// a `used` flag is kept alongside the key/value slots rather than relying on a sentinel value.
+struct EditTable {
+	std::vector<int64_t> keys;
+	std::vector<int32_t> vals;
+	std::vector<uint8_t> used;
+	uint32_t mask = 0;
