+// FP_CPP_TILE_BAKE (F1, docs/COSMOS-CPP-PARALLEL-SAMPLER-DESIGN.md §2/§4): the 14 far-field colours'
+// FIXED order -- FarPalette.frozen_colors() (far_palette.gd) hands them over in EXACTLY this order, and
+// it is also `far_colors`' order (see Parameters::far_colors / far_color below). Declared here (rather
+// than next to far_color, its original location) because setup() needs FC_COUNT to size canon_idx.
+enum FarColor {
+	FC_WATER = 0, FC_ICE, FC_LAVA, FC_SNOW, FC_SAND, FC_GRAVEL, FC_RED_SAND, FC_MUD,
+	FC_PODZOL, FC_GRASS, FC_LEAF, FC_STONE, FC_TAIGA, FC_FOREST, FC_COUNT
+};
+// canon_idx reserves one extra slot, past the 14 far_colors entries, for the B_PILLAR corner-monument
+// grey LITERAL (far_color's `Color(0.20, 0.20, 0.23)`, not a catalog colour -- far_palette.gd:107 / 0008
+// hunk line 114). See Parameters::canon_idx.
+constexpr int FC_PILLAR = FC_COUNT;
+constexpr int FC_CANON_SIZE = FC_COUNT + 1;
+
+// A byte-equal port of FarPalette.far_color_index's nearest-RGB scan (far_palette.gd:170-182): `r,g,b`
+// (already widened to f64 by the caller, mirroring `c.r/c.g/c.b` read out of a f32 Color) against
+// `table[0..n)`'s f32 components, ALSO widened to f64 before the subtraction -- squared-distance, STRICT
+// `<` comparison. The strictness is load-bearing: it is what makes ties resolve to the FIRST matching
+// index (FarPalette's aliasing behaviour), not merely an optimization.
+int nearest_far_index(double r, double g, double b, const PackedColorArray &table, int n) {
+	int best = 0;
+	double best_d = 1.0e30;
+	for (int i = 0; i < n; ++i) {
+		const Color c = table[i];
+		const double dr = r - double(c.r);
+		const double dg = g - double(c.g);
+		const double db = b - double(c.b);
+		const double d = dr * dr + dg * dg + db * db;
+		if (d < best_d) {
+			best_d = d;
+			best = i;
+		}
+	}
+	return best;
+}
+
