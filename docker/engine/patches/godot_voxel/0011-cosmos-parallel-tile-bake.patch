+// Pack a lattice column (x, z) into the int64 form facet_tex_baker.gd's `_pack_xz` (and sample_columns'
+// callers) use: x in the low 32 bits, z in the high 32, both reinterpreted through uint32 first so
+// negative lattice coordinates round-trip exactly (mirrors sample_columns' unpacking, in reverse).
+inline int64_t pack_xz(int x, int z) {
+	return int64_t(uint32_t(x)) | (int64_t(uint32_t(z)) << 32);
+}
+
+// A byte-equal port of facet_tex_baker.gd's static `_bilerp` (facet_tex_baker.gd:2016-2017): f64 math
+// over corner values that are ALREADY f32-narrowed by the caller (widened from the PackedVector2Array's
+// Vector2 -- real_t -- components), corner order (v00, v10, v11, v01).
+inline double bilerp(double v00, double v10, double v11, double v01, double s, double t) {
+	return v00 * (1.0 - s) * (1.0 - t) + v10 * s * (1.0 - t) + v11 * s * t + v01 * (1.0 - s) * t;
+}
