+// (terrain_config.gd:688-709). `t` is the latitude-anchored annual-mean temperature, `h` is the static
+// humidity noise. Pure/deterministic; the ocean/beach/mountain guards are applied by the caller
+// (biome_of), never here -- same division of labour as the GDScript twin.
+inline int whittaker_biome(double t, double h) {
+	if (t > 0.45) { // hot (equatorial / low latitude)
+		if (h < -0.45) {
+			return B_BADLANDS;
+		}
+		if (h < 0.0) {
+			return B_DESERT;
+		}
+		if (h < 0.4) {
+			return B_SAVANNA;
+		}
+		return B_JUNGLE;
+	}
+	if (t > 0.15) { // warm (subtropical)
