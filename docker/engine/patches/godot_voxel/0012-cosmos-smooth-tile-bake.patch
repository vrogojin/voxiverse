+	//   "pos"/"planar"/"relief"      -- node_at's own radial pos / planar term / relief scalar, included
+	//                                  as a convenience so a caller need not re-derive them from dir+g.
+	Dictionary bake_smooth_tile(PackedFloat64Array corner_dirs, double r_datum, int cells) const;
