+// --- StructureGen (structure_gen.gd) -- the P1b village-generator mirror ------------------------
+// Line-for-line port of the StructureGen statics. `_hash01` is a verbatim copy of TreeGen._hash01, so
+// every hash reuses cosmos::tree_hash01 with the 201-209 salts -- no new hashing/int-width traps. The
+// floori-of-a-float-division for the lattice indices is the SAME negative-coordinate trap the tree port
+// documents (integer division truncates toward zero across half the world); done via cosmos::floori.
+
+// Port of StructureGen._is_earth: villages exist on EARTH facets ONLY (FACETED + body 0 == fid < 6*K*K).
+// The Moon aliases biome ids 11/12/13, so a biome-only site test would place villages on moon columns.
+bool VoxelGeneratorCosmos::struct_is_earth(const Parameters &p, int fid) {
+	return p.faceted && fid >= 0 && fid < p.struct_earth_facets;
+}
+
+// Port of StructureGen._site_biome_ok: B_PLAINS always, B_SAVANNA only under climate_biomes.
+bool VoxelGeneratorCosmos::struct_site_biome_ok(const Parameters &p, int biome) {
+	if (biome == B_PLAINS) {
+		return true;
+	}
+	if (p.climate_biomes && biome == B_SAVANNA) {
+		return true;
+	}
+	return false;
+}
+
+// Port of StructureGen.has_village: body gate FIRST, then salt-201, then the site test (biome / flat
+// stencil / above-sea). Pure.
+bool VoxelGeneratorCosmos::struct_has_village(const Parameters &p, int fid, int vx, int vz) {
+	if (!struct_is_earth(p, fid)) {
+		return false; // body gate FIRST (the Moon biome-id alias trap)
+	}
+	if (tree_hash01(vx, vz, SALT_VILLAGE) >= VILLAGE_CHANCE) {
+		return false;
+	}
+	const int ax = vx * STRUCT_V + STRUCT_V / 2;
+	const int az = vz * STRUCT_V + STRUCT_V / 2;
+	if (!struct_site_biome_ok(p, int(column_profile_core(p, fid, ax, az).y))) {
+		return false;
+	}
+	// 4x4 flat stencil at pitch 8, max-min column_top <= 4.
+	int mn = 0x7fffffff;
+	int mx = -0x7fffffff;
+	for (int iz = 0; iz < 4; ++iz) {
+		for (int ix = 0; ix < 4; ++ix) {
+			const int h = col_h(p, fid, ax + ix * 8, az + iz * 8);
+			mn = mini(mn, h);
+			mx = maxi(mx, h);
+		}
+	}
+	if (mx - mn > STRUCT_LEVEL_TOL) {
+		return false; // CARVE-TO-MIN: reject only sheer-cliff sites (>16 variation); rolling plains are leveled
+	}
+	if (col_h(p, fid, ax, az) <= SEA_LEVEL + 2) {
+		return false; // above the water line -- no half-drowned village
+	}
+	return true;
+}
+
+// Port of StructureGen._jitter: an offset in [2, HCELL-dim-2] so base+dim-1 <= HCELL-3 < the next cell.
+int VoxelGeneratorCosmos::struct_jitter(int hx, int hz, int salt, int dim) {
+	const int span = STRUCT_HCELL - dim - 3;
+	return 2 + int(tree_hash01(hx, hz, salt) * double(span));
+}
+
+// Port of StructureGen.house_info: owning village live -> salt-202 -> footprint-corner flatness AND no
+// corner on a firing slope -> params from salts 203-209. Empty (valid=false) mirrors the {} return.
+VoxelGeneratorCosmos::StructHouse VoxelGeneratorCosmos::struct_house_info(
+		const Parameters &p, int fid, int hx, int hz) {
+	StructHouse hi;
+	const int vx = int(floori(double(hx) / double(STRUCT_HPV)));
+	const int vz = int(floori(double(hz) / double(STRUCT_HPV)));
+	if (!struct_has_village(p, fid, vx, vz)) {
+		return hi;
+	}
+	if (tree_hash01(hx, hz, SALT_HOUSE) >= HOUSE_CHANCE) {
+		return hi;
+	}
+	const int w = STRUCT_FOOT_MIN + int(tree_hash01(hx, hz, SALT_W) * double(STRUCT_FOOT_MAX - STRUCT_FOOT_MIN + 1));
+	const int d = STRUCT_FOOT_MIN + int(tree_hash01(hx, hz, SALT_D) * double(STRUCT_FOOT_MAX - STRUCT_FOOT_MIN + 1));
+	const int base_x = hx * STRUCT_HCELL + struct_jitter(hx, hz, SALT_JITX, w);
+	const int base_z = hz * STRUCT_HCELL + struct_jitter(hx, hz, SALT_JITZ, d);
+	// Footprint-corner flatness + slope reject (in corner order (x,z),(x+w-1,z),(x+w-1,z+d-1),(x,z+d-1)).
+	const int cx[4] = { base_x, base_x + w - 1, base_x + w - 1, base_x };
+	const int cz[4] = { base_z, base_z, base_z + d - 1, base_z + d - 1 };
+	int mn = 0x7fffffff;
+	int mx = -0x7fffffff;
+	for (int i = 0; i < 4; ++i) {
+		const int h = col_h(p, fid, cx[i], cz[i]);
+		mn = mini(mn, h);
+		mx = maxi(mx, h);
+		// slope_run_fires(slope_run_of(cx,cz)) worker-path == slope_fires_only with g = col_h (this column).
+		if (slope_fires_only(p, fid, cx[i], cz[i], h)) {
+			return hi; // a corner on a firing slope -- skip this house
+		}
+	}
+	if (mx - mn > STRUCT_LEVEL_TOL) {
+		return hi; // CARVE-TO-MIN: skip only cliff footprints (>16); leveled sites are carved down to base_y
+	}
+	const int wall_h = WALL_MIN + int(tree_hash01(hx, hz, SALT_WALLH) * double(WALL_MAX - WALL_MIN + 1));
+	const int door = int(tree_hash01(hx, hz, SALT_DOOR) * 4.0); // 0=-x 1=+x 2=-z 3=+z
+	int roof = tree_hash01(hx, hz, SALT_ROOF) < 0.5 ? 1 : 0;    // 1 = gabled, 0 = flat
+	const int base_y = mn;                                       // CARVE-TO-MIN: pad at the LOWEST footprint corner
+	int gable_h = 0;
+	if (roof == 1) {
+		gable_h = mini(d / 2, STRUCT_H_MAX - wall_h); // capped so wall_h + gable_h <= STRUCT_H_MAX
+		if (gable_h < 1) {
+			roof = 0; // < 1 -> fall back to flat
+		}
+	}
+	hi.valid = true;
+	hi.base_x = base_x;
+	hi.base_y = base_y;
+	hi.base_z = base_z;
+	hi.w = w;
+	hi.d = d;
+	hi.wall_h = wall_h;
+	hi.door = door;
+	hi.roof = roof;
+	hi.gable_h = gable_h;
+	return hi;
+}
+
+// Port of StructureGen._roof_top_ly: the topmost local y (relative to base.y) the roof reaches.
+int VoxelGeneratorCosmos::struct_roof_top_ly(const StructHouse &hi) {
+	return hi.wall_h + (hi.roof == 1 ? hi.gable_h : 1);
+}
+
+// Port of StructureGen._is_door: a 1-wide, 2-tall opening at the centre of the hash-chosen wall.
+bool VoxelGeneratorCosmos::struct_is_door(const StructHouse &hi, int lx, int lz, int ly) {
+	if (ly > 2) {
+		return false;
+	}
+	const int w = hi.w;
+	const int d = hi.d;
+	const int midw = w / 2;
+	const int midd = d / 2;
+	switch (hi.door) {
+		case 0:
+			return lx == 0 && lz == midd;
+		case 1:
+			return lx == w - 1 && lz == midd;
+		case 2:
+			return lz == 0 && lx == midw;
+		case 3:
+			return lz == d - 1 && lx == midw;
+	}
+	return false;
+}
+
+// Port of StructureGen._is_window: one window per wall at mid height (ly == 2), except at the door.
+bool VoxelGeneratorCosmos::struct_is_window(const StructHouse &hi, int lx, int lz, int ly, int w, int d) {
+	if (ly != 2) {
+		return false;
+	}
+	if (struct_is_door(hi, lx, lz, ly)) {
+		return false;
+	}
+	const int midw = w / 2;
+	const int midd = d / 2;
+	if (lz == 0 && lx == midw) {
+		return true;
+	}
+	if (lz == d - 1 && lx == midw) {
+		return true;
+	}
+	if (lx == 0 && lz == midd) {
+		return true;
+	}
+	if (lx == w - 1 && lz == midd) {
+		return true;
+	}
+	return false;
+}
+
+// Port of StructureGen._roof_block: a flat plank slab one course above the walls, OR a gable across z.
+int VoxelGeneratorCosmos::struct_roof_block(
+		const Parameters &p, const StructHouse &hi, int lx, int lz, int ly, int w, int d, int wall_h) {
+	(void)w;
+	if (hi.roof == 0) {
+		return (ly == wall_h + 1) ? p.struct_roof : ID_AIR; // flat slab
+	}
+	const int k = ly - wall_h; // >= 1
+	if (k - 1 > d - k) {
+		return ID_AIR; // above the ridge
+	}
+	if (lz == k - 1 || lz == d - k) {
+		return p.struct_roof;
+	}
+	return ID_AIR;
+}
+
+// Port of StructureGen._template_block: -1 (outside / above roof / at-or-below ground), 0 (interior/door
+// AIR -- authoritative), or a house block id (>0). Materials are the frozen ids resolved from BlockCatalog.
+int VoxelGeneratorCosmos::struct_template_block(
+		const Parameters &p, const StructHouse &hi, int x, int y, int z, int cg) {
+	const int w = hi.w;
+	const int d = hi.d;
+	const int lx = x - hi.base_x;
+	const int lz = z - hi.base_z;
+	if (lx < 0 || lx >= w || lz < 0 || lz >= d) {
+		return -1; // outside the footprint
+	}
+	// CARVE-TO-MIN: the floor sits ONE course above the pad (base_y+1). ly<0 (y<=base_y) is the natural
+	// terrain forming the platform's solid base -- byte-untouched, NO foundation fill (base_y = min footprint
+	// corner => every footprint column is solid up to base_y, so there is nothing to fill).
+	const int ly = y - hi.base_y - 1;
+	if (ly < 0) {
+		return -1; // y <= base_y -> natural pad base (fall through)
+	}
+	if (ly > struct_roof_top_ly(hi)) {
+		// Above the house roof: terrain poking above the flattened pad (base_y < y <= g) is CARVED to air;
+		// open sky above g stays fall-through.
+		if (y <= cg) {
+			return 0; // CARVE -- authoritative air (levels the footprint down to the pad)
+		}
+		return -1; // open sky above g
+	}
+	if (ly == 0) {
+		return p.struct_floor; // solid floor course at base_y+1
+	}
+	const int wall_h = hi.wall_h;
+	if (ly <= wall_h) {
+		const bool edge = (lx == 0 || lx == w - 1 || lz == 0 || lz == d - 1);
+		if (!edge) {
+			return 0; // interior air -- AUTHORITATIVE (suppresses snow stack + lip)
+		}
+		if ((lx == 0 || lx == w - 1) && (lz == 0 || lz == d - 1)) {
+			return p.struct_post; // corner posts
+		}
+		if (struct_is_door(hi, lx, lz, ly)) {
+			return 0; // door gap -- authoritative air (passable)
+		}
+		if (struct_is_window(hi, lx, lz, ly, w, d)) {
+			return p.struct_window;
+		}
+		return p.struct_wall;
+	}
+	return struct_roof_block(p, hi, lx, lz, ly, w, d, wall_h); // roof region (ly > wall_h)
+}
+
+// Port of StructureGen.claim_at: the hot-path tri-state. `cg` is the column ground resolve_cell already
+// computed (== int(prof.x) == col_h), so there is ZERO recompute. -1 fall-through / 0 interior air / >0
+// house block id. The y-window early-out (ZERO structure hashes) IS the §12.2 height-budget clamp.
+int VoxelGeneratorCosmos::struct_claim_at(const Parameters &p, int fid, int x, int y, int z, int cg) {
+	// CARVE-TO-MIN LOWER early-out: a house never touches y <= base_y (the natural pad base), and base_y =
+	// min footprint corner >= cg - STRUCT_LEVEL_TOL for a corner-bounded column, so the deepest carve/floor
+	// cell is > cg - STRUCT_LEVEL_TOL. Cells more than STRUCT_LEVEL_TOL below cg can never be a claim (this
+	// is also the carve-depth bound). Was `y <= cg -> -1`; carve now fires at y <= g so that guard is gone.
+	if (cg - y > STRUCT_LEVEL_TOL) {
+		return -1; // below any possible flattened pad -- natural terrain (byte-untouched)
+	}
+	if (y - cg > STRUCT_H_MAX + STRUCT_FLAT_TOL) {
+		return -1; // above every possible roof -- the height-budget clamp (14 = TreeGen.MAX_ABOVE_SURFACE)
+	}
+	const int vx = int(floori(double(x) / double(STRUCT_V)));
+	const int vz = int(floori(double(z) / double(STRUCT_V)));
+	if (!struct_has_village(p, fid, vx, vz)) {
+		return -1;
+	}
+	const int hx = int(floori(double(x) / double(STRUCT_HCELL)));
+	const int hz = int(floori(double(z) / double(STRUCT_HCELL)));
+	const StructHouse hi = struct_house_info(p, fid, hx, hz);
+	if (!hi.valid) {
+		return -1;
+	}
+	return struct_template_block(p, hi, x, y, z, cg);
+}
