+constexpr double VILLAGE_CHANCE = 0.5;  // salt 201 gate on the (vx, vz) village cell
+constexpr double HOUSE_CHANCE = 0.55;    // salt 202 gate per (hx, hz) sub-cell inside a live village
+constexpr int STRUCT_H_MAX = 11;         // §12.2 tallest cell over base: walls <= 4 + roof <= 7
+constexpr int STRUCT_FLAT_TOL = 3;       // §12.2 height-budget slack (STRUCT_H_MAX+FLAT_TOL = MAX_ABOVE_SURFACE=14)
+constexpr int STRUCT_LEVEL_TOL = 16;     // CARVE-TO-MIN: site/footprint terrain-variation cap (rolling plains, not cliffs; bounds carve depth)
+constexpr int FOUNDATION_MAX = 4;        // legacy (no foundation under carve-to-min); kept for record padding
+constexpr int WALL_MIN = 3;              // wall course count in [3, 4]
+constexpr int WALL_MAX = 4;
