+constexpr int SALT_VILLAGE = 201;        // village-cell gate
+constexpr int SALT_HOUSE = 202;          // per-house gate
+constexpr int SALT_JITX = 203;           // footprint x jitter
+constexpr int SALT_JITZ = 204;           // footprint z jitter
+constexpr int SALT_W = 205;              // footprint width
+constexpr int SALT_D = 206;              // footprint depth
+constexpr int SALT_WALLH = 207;          // wall-course count
+constexpr int SALT_DOOR = 208;           // door side (0..3)
+constexpr int SALT_ROOF = 209;           // roof type + material pick
