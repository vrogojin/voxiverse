+constexpr int STRUCT_HCELL = 32;         // house sub-lattice pitch inside a live village
+constexpr int STRUCT_HPV = 6;            // STRUCT_V / STRUCT_HCELL -- house sub-cells per axis in a village
+constexpr int STRUCT_FOOT_MAX = 11;      // footprint <= 11x11; jitter in [2, HCELL-dim-2] keeps it inside its H-cell
