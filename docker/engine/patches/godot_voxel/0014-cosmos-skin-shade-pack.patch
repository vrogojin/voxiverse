+// steps of the [0.15, 1] analytic shade) -- max byte 1 + 13 + 14*17 = 252 <= 255, and 0 stays the
+// un-baked sentinel. far_idx is ALWAYS 0..13 in bake_far_tile's path: every branch resolves through
+// canon_idx / deco_far_idx / edit_far_idx, all of which hold nearest-in-far_colors indices (FC_COUNT
+// = 14 entries); a rogue fi >= 14 (malformed caller LUT) skips packing and writes the legacy idx byte.
+// The quantiser literals (0.15 / 0.85 / 17.0, floor(x + 0.5)) MUST literal-match SurfaceShot.shade_q
+// (surface_shot.gd) -- (1.0 - 0.15) != 0.85 in f64, so both sides spell the same literals.
+constexpr int SHADE_PACK_LANES = 14;
+constexpr int SHADE_PACK_STEPS = 18;
+
+// FP_SKIN_SHADE_PACK: byte-equal port of SurfaceShot._shade (surface_shot.gd:80-103). Term order,
+// literals, and the [0.15, 1] clamp are line-for-line; every neighbour height/canopy resolves through
+// the already-byte-equal column_profile_core / tree_top_decoration mirrors, so `s` is bit-identical
+// to the GDScript reference for the same column. GDScript floats are f64: minf == MIN(double),
+// absi == Math::abs(int), maxi == MAX(int), clampf == CLAMP(double).
+double VoxelGeneratorCosmos::bake_shade(
+		const Parameters &p, int fid, int x, int z, int g, bool is_tree, bool clamped_sea) {
+	// (a) hillshade / AO from the 4-neighbour column-height stencil (cliff-base & slope darkening).
+	const int gE = int(column_profile_core(p, fid, x + 1, z).x);
+	const int gW = int(column_profile_core(p, fid, x - 1, z).x);
+	const int gN = int(column_profile_core(p, fid, x, z + 1).x);
+	const int gS = int(column_profile_core(p, fid, x, z - 1).x);
+	const int slope = Math::abs(gE - gW) + Math::abs(gN - gS); // central-difference gradient magnitude (blocks)
+	const int concave = (gE + gW + gN + gS) - 4 * g; // >0 => column below its neighbours (in a hollow)
+	double s = 1.0;
+	s -= MIN(double(slope) * 0.045, 0.45); // AO_SLOPE_K / AO_SLOPE_MAX
+	s -= MIN(double(MAX(concave, 0)) * 0.030, 0.35); // AO_CONCAVE_K / AO_CONCAVE_MAX
+	// (b) water-depth darkening -- deeper sea floor reads darker. Only for submerged columns.
+	if (clamped_sea) {
+		s -= MIN(double(cosmos::SEA_LEVEL - g) * 0.030, 0.55); // WATER_DEPTH_K / WATER_DEPTH_MAX
+	}
+	// (c) canopy ground-shadow -- a GROUND column adjacent to a canopy sits in its penumbra. Tree-top
+	// columns ARE the canopy (lit), so they take no ground shadow.
+	if (!is_tree) {
+		int near_c = 0;
+		if (tree_top_decoration(p, fid, x + 1, z) != cosmos::ID_AIR) {
+			near_c += 1;
+		}
+		if (tree_top_decoration(p, fid, x - 1, z) != cosmos::ID_AIR) {
+			near_c += 1;
+		}
+		if (tree_top_decoration(p, fid, x, z + 1) != cosmos::ID_AIR) {
+			near_c += 1;
+		}
+		if (tree_top_decoration(p, fid, x, z - 1) != cosmos::ID_AIR) {
+			near_c += 1;
+		}
+		s -= MIN(double(near_c) * 0.07, 0.28); // CANOPY_SHADOW / CANOPY_SHADOW_MAX
+	}
+	return CLAMP(s, 0.15, 1.0); // SHADE_FLOOR
