+void VoxelMemoryPool::prewarm(size_t size, unsigned int count) {
+	// COSMOS GEN-CONVOY §4.B lever 3. Only the pooled size classes benefit; oversize allocations are never
+	// pooled (see allocate()), so a size past the highest supported class is a no-op rather than a leak.
+	if (size == 0 || size > get_highest_supported_size()) {
+		return;
+	}
+	const unsigned int pot = get_pool_index_from_size(size);
+	Pool &pool = _pot_pools[pot];
+	const size_t capacity = get_size_from_pool_index(pot);
+	MutexLock lock(pool.mutex);
+	// Ensure the free-list holds at least `count` blocks; idempotent so repeated setups (facet flips) never
+	// over-grow. These mallocs are paid HERE, on the main thread at setup, precisely so the workers do not
+	// pay them on the global dlmalloc lock during a streaming burst. Accounting mirrors clear()/allocate():
+	// each cached block adds `capacity` to _total_memory (get_size_from_pool_index(pot)), and stays _used=0.
+	while (pool.blocks.size() < count) {
+		uint8_t *block = (uint8_t *)ZN_ALLOC(capacity * sizeof(uint8_t));
+		if (block == nullptr) {
+			break;
+		}
+		pool.blocks.push_back(block);
+		_total_memory += capacity;
+	}
+}
