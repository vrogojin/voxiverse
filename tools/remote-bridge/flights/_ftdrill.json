{ "name":"ftdrill","description":"FALL-THROUGH BAND DRILL: tp to lat8/lon2 crossing, settle, fast lateral crossings; probe watches floor vs surface",
  "legs":[
    {"name":"noon","steps":[{"op":"set_time","local_hours":12}],"settle_s":0.5},
    {"name":"tp band","steps":[{"op":"teleport","lat_deg":8,"lon_deg":2,"alt":30}],"settle_s":2.0},
    {"name":"settle","steps":[{"op":"wait","seconds":5}],"settle_s":5.0,"expect":{"alt_gt":-1}},
    {"name":"run N","steps":[{"op":"thrust","dz":1.0,"seconds":6,"gait":"run"}],"settle_s":1.5,"expect":{"alt_gt":-1}},
    {"name":"run S","steps":[{"op":"thrust","dz":-1.0,"seconds":6,"gait":"run"}],"settle_s":1.5,"expect":{"alt_gt":-1}},
    {"name":"run E","steps":[{"op":"thrust","dx":1.0,"seconds":6,"gait":"run"}],"settle_s":1.5,"expect":{"alt_gt":-1}},
    {"name":"run W","steps":[{"op":"thrust","dx":-1.0,"seconds":6,"gait":"run"}],"settle_s":1.5,"expect":{"alt_gt":-1}},
    {"name":"look","steps":[{"op":"look","pitch_deg":-20}],"settle_s":1.0},
    {"name":"shot","steps":[{"op":"screenshot","label":"ftdrill"}],"settle_s":1.8}]}
