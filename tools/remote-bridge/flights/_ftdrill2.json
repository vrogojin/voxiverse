    {"name":"E1","steps":[{"op":"thrust","dx":1.0,"seconds":12,"gait":"run"}],"settle_s":0.8,"expect":{"alt_gt":-1}},
    {"name":"E2","steps":[{"op":"thrust","dx":1.0,"seconds":12,"gait":"run"}],"settle_s":0.8,"expect":{"alt_gt":-1}},
    {"name":"E3","steps":[{"op":"thrust","dx":1.0,"seconds":12,"gait":"run"}],"settle_s":0.8,"expect":{"alt_gt":-1}},
    {"name":"E4","steps":[{"op":"thrust","dx":1.0,"seconds":12,"gait":"run"}],"settle_s":0.8,"expect":{"alt_gt":-1}},
    {"name":"E5","steps":[{"op":"thrust","dx":1.0,"seconds":12,"gait":"run"}],"settle_s":0.8,"expect":{"alt_gt":-1}},
    {"name":"N1","steps":[{"op":"thrust","dz":1.0,"seconds":12,"gait":"run"}],"settle_s":0.8,"expect":{"alt_gt":-1}},
    {"name":"N2","steps":[{"op":"thrust","dz":1.0,"seconds":12,"gait":"run"}],"settle_s":0.8,"expect":{"alt_gt":-1}},
