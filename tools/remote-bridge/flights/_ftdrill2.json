    {"name":"climb","steps":[{"op":"dev_nav","on":true}],"settle_s":0.5},
    {"name":"up","steps":[{"op":"thrust","dy":1.0,"seconds":10,"gait":"run"}],"settle_s":0.8},
    {"name":"skimE","steps":[{"op":"thrust","dx":1.0,"seconds":18,"gait":"run"}],"settle_s":0.8},
    {"name":"descend-across","steps":[{"op":"thrust","dx":1.0,"dy":-1.0,"seconds":16,"gait":"run"}],"settle_s":1.0},
    {"name":"land off","steps":[{"op":"dev_nav","on":false}],"settle_s":4.0,"expect":{"alt_gt":-1}},
    {"name":"shot","steps":[{"op":"screenshot","label":"ftdrill2"}],"settle_s":1.8}]}
